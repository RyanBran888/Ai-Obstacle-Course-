# Training artifacts (DQN side).
# Checkpoints and run logs are large and regenerable; keep them out of history.
*.pt
*.pth
*.ckpt
*.h5
checkpoints/
runs/
logs/
wandb/
mlruns/
tensorboard/

# Generated environment inspection artifacts.
# Galleries, SVGs, and room dumps are all reproducible from a seed --
# rebuild with `python3 tools/generate_gallery.py` rather than committing them.
# Scoped to output/ on purpose: hand-authored .svg design assets elsewhere in
# the tree should still be tracked.
Architecture/output/
output/

# macOS.
# This repo lives on a non-HFS volume, so Finder scatters AppleDouble sidecars
# (`._name`) next to every file. They are metadata, not source.
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd/
.TemporaryItems

# Windows
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
